#version 460
layout(local_size_x =   5, local_size_y =   5, local_size_z =   5) in;
layout(binding = 0) uniform sampler3D positions;
layout(binding = 1) uniform sampler3D velocities;
layout(binding = 2) uniform sampler3D celltypes;
layout(binding = 3, rg32f)           uniform image3D prevstaggeredu; /* .x = vel.u, .y = interpolation weight */
layout(binding = 4, rg32f)           uniform image3D prevstaggeredv; /* .x = vel.v, .y = interpolation weight */
layout(binding = 5, rg32f)           uniform image3D prevstaggeredw; /* .x = vel.w, .y = interpolation weight */
layout(binding = 6, rg32f) writeonly uniform image3D nextstaggeredu; /* .x = vel.u, .y = interpolation weight */
layout(binding = 7, rg32f) writeonly uniform image3D nextstaggeredv; /* .x = vel.v, .y = interpolation weight */
layout(binding = 8, rg32f) writeonly uniform image3D nextstaggeredw; /* .x = vel.w, .y = interpolation weight */


uniform vec3  u_bottomLeftmostPosition;
uniform float ku_dl;


const float halfdl = ku_dl * 0.5f;


vec2 fetchStaggered(in image3D grid, in ivec3 coord, in bool RightTrueLeftFalse)
{
    return texelFetch(grid, coord + ivec3(0, int(RightTrueLeftFalse), 0), 0).xy;
}


vec2 fetchStaggeredQuantity(in image3D grid, in ivec3 coord, in bool RightTrueLeftFalse)
{
    return texelFetch(grid, coord + ivec3(0, int(RightTrueLeftFalse), 0), 0).x;
}


vec3 barycentricWeights(vec3 position)
{
    vec3 gridDisplacement = ( position - vec3(u_bottomLeftmostPosition) ) / ku_dl;
    ivec3 ijk = floor(gridDisplacement);
    return gridDisplacement - vec3(ijk);
}

ivec3 getIndices(vec3 position)
{
    return floor( ( position - vec3(u_bottomLeftmostPosition) ) / ku_dl );
}



