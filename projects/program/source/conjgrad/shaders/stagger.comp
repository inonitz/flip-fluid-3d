void splatWeightedVelcitiesX(
    in image3D destination
    in vec3 position, 
    in vec3 velocity,
    in vec3 shiftOffset
) {
    vec3  shifted, w, omw;
    ivec3 shiftedi;
    float volumeFactors[8];

    /* Shift across X direction (i coordinate) */
    // shifted = vec3(
    //     position.x,
    //     position.y - halfdl,
    //     position.z - halfdl
    // );
    shifted  = position - shiftOffset;
    shiftedi = floor(shifted);
    w = barycentricWeights(shifted);
    omw = vec3(1.0f) - w;

    /* 
        Every Index i that is inc/dec gets w_i weight attached, otherwise 1-w_i
        Regardless of whether it is by 1/2 or 1 
    */
    /* the indices in comments are for illustration in the X direction */
    volumeFactors = float[8](
        /* (i, j, k) + (-0.5, 0, 0) */ omw.x * omw.y * omw.z, 
        /* (i, j, k) + (+0.5, 0, 0) */ w.x   * omw.y * omw.z,
        /* (i, j, k) + (-0.5, 1, 0) */ omw.x * w.y   * omw.z,
        /* (i, j, k) + (+0.5, 1, 0) */ w.x   * w.y   * omw.z,
        /* (i, j, k) + (-0.5, 0, 1) */ omw.x * omw.y * w.z,
        /* (i, j, k) + (+0.5, 0, 1) */ w.x   * omw.y * w.z,
        /* (i, j, k) + (-0.5, 1, 1) */ omw.x * w.y   * w.z,
        /* (i, j, k) + (+0.5, 1, 1) */ w.x   * w.y   * w.z,
    );
    imageStore(staggeredu, shiftedi + ivec3(0, 0, 0), vel.x * volumeFactors[0]);
    imageStore(staggeredu, shiftedi + ivec3(1, 0, 0), vel.x * volumeFactors[1]);
    imageStore(staggeredu, shiftedi + ivec3(0, 1, 0), vel.x * volumeFactors[2]);
    imageStore(staggeredu, shiftedi + ivec3(1, 1, 0), vel.x * volumeFactors[3]);
    imageStore(staggeredu, shiftedi + ivec3(0, 0, 1), vel.x * volumeFactors[4]);
    imageStore(staggeredu, shiftedi + ivec3(1, 0, 1), vel.x * volumeFactors[5]);
    imageStore(staggeredu, shiftedi + ivec3(0, 1, 1), vel.x * volumeFactors[6]);
    imageStore(staggeredu, shiftedi + ivec3(1, 1, 1), vel.x * volumeFactors[7]);
    return;
}


void splatWeightedVelcities(
    in image3D oldval,
    in image3D dest
    in vec3    position, 
    in float   vel,
    in vec3    shiftOffset
) {
    vec3  shifted, w, omw;
    ivec3 shiftedi;
    float volumeFactors[8];
    ivec3 finalIndices[8];

    /* Shift across a direction (i/j/k coordinate) */
    shifted  = position - shiftOffset;
    shiftedi = floor(shifted);
    w   = barycentricWeights(shifted);
    omw = vec3(1.0f) - w;

    /* 
        Every Index Q that is inc/dec gets w_q weight attached, otherwise 1-w_q
        Regardless of whether it is by 1/2 or 1 
    */
    /* the indices in comments are for illustration in the X direction */
    /* This can also apply in the y or z direction */
    volumeFactors = float[8](
        /* (i, j, k) + (-0.5, 0, 0) */ omw.x * omw.y * omw.z, 
        /* (i, j, k) + (+0.5, 0, 0) */ w.x   * omw.y * omw.z,
        /* (i, j, k) + (-0.5, 1, 0) */ omw.x * w.y   * omw.z,
        /* (i, j, k) + (+0.5, 1, 0) */ w.x   * w.y   * omw.z,
        /* (i, j, k) + (-0.5, 0, 1) */ omw.x * omw.y * w.z,
        /* (i, j, k) + (+0.5, 0, 1) */ w.x   * omw.y * w.z,
        /* (i, j, k) + (-0.5, 1, 1) */ omw.x * w.y   * w.z,
        /* (i, j, k) + (+0.5, 1, 1) */ w.x   * w.y   * w.z,
    );
    finalIndices = ivec3[8](
        shiftedi + ivec3(0, 0, 0),
        shiftedi + ivec3(1, 0, 0),
        shiftedi + ivec3(0, 1, 0),
        shiftedi + ivec3(1, 1, 0),
        shiftedi + ivec3(0, 0, 1),
        shiftedi + ivec3(1, 0, 1),
        shiftedi + ivec3(0, 1, 1),
        shiftedi + ivec3(1, 1, 1)
    )
    /*
        velocity must be multiplied by the volume factor
        that is not done here, to save time
        next compute pass is boundary conditions, and its more relevant there

        Moreover, this is incomplete because I need to:
        old = imageRead(...)
        updated = old + currently_calc_value;
        imageWrite(..., updated);
        Need to add texture ping-pong again.
    */
    
    vec2 to_write = vec2(0); 
    for(uint i = 0; i < 8; ++i) {
        to_write  = imageLoad(oldval, finalIndices[i], 0).xy;
        to_write += vec2(vel, volumeFactors[i]);
        imageStore(dest, finalIndices[i], vec4(to_write, 0, 0) );
    }
    return;
}



